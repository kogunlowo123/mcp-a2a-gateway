{
  "$defs": {
    "AgentCapabilities": {
      "additionalProperties": true,
      "properties": {
        "pushNotifications": {
          "default": false,
          "title": "Pushnotifications",
          "type": "boolean"
        },
        "stateTransitionHistory": {
          "default": false,
          "title": "Statetransitionhistory",
          "type": "boolean"
        },
        "streaming": {
          "default": false,
          "title": "Streaming",
          "type": "boolean"
        }
      },
      "title": "AgentCapabilities",
      "type": "object"
    },
    "AgentCard": {
      "additionalProperties": true,
      "description": "A2A Agent Card. Unknown fields are preserved so signatures stay verifiable.",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/AgentCapabilities",
          "default": {
            "pushNotifications": false,
            "stateTransitionHistory": false,
            "streaming": false
          }
        },
        "defaultInputModes": {
          "default": [
            "text/plain"
          ],
          "items": {
            "type": "string"
          },
          "title": "Defaultinputmodes",
          "type": "array"
        },
        "defaultOutputModes": {
          "default": [
            "text/plain"
          ],
          "items": {
            "type": "string"
          },
          "title": "Defaultoutputmodes",
          "type": "array"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "preferredTransport": {
          "default": "JSONRPC",
          "title": "Preferredtransport",
          "type": "string"
        },
        "protocolVersion": {
          "default": "0.3.0",
          "title": "Protocolversion",
          "type": "string"
        },
        "security": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Security"
        },
        "securitySchemes": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Securityschemes"
        },
        "signatures": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/AgentCardSignature"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signatures"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/AgentSkill"
          },
          "minItems": 1,
          "title": "Skills",
          "type": "array"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "version",
        "skills"
      ],
      "title": "AgentCard",
      "type": "object"
    },
    "AgentCardSignature": {
      "additionalProperties": false,
      "description": "JWS over the canonical card (A2A ``AgentCardSignature``).",
      "properties": {
        "header": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header"
        },
        "protected": {
          "description": "base64url JWS protected header",
          "minLength": 4,
          "title": "Protected",
          "type": "string"
        },
        "signature": {
          "description": "base64url signature",
          "minLength": 4,
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "protected",
        "signature"
      ],
      "title": "AgentCardSignature",
      "type": "object"
    },
    "AgentSkill": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "examples": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Examples",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "inputModes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputmodes"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "outputModes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outputmodes"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "AgentSkill",
      "type": "object"
    },
    "CardPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_callers": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Callers",
          "type": "array"
        },
        "allowed_skills": {
          "default": [],
          "description": "Skill ids callers may target; empty allows every card skill",
          "items": {
            "type": "string"
          },
          "title": "Allowed Skills",
          "type": "array"
        },
        "classification": {
          "$ref": "#/$defs/DataClassification"
        },
        "redact_pii": {
          "default": true,
          "title": "Redact Pii",
          "type": "boolean"
        },
        "requires_approval": {
          "default": false,
          "title": "Requires Approval",
          "type": "boolean"
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel"
        }
      },
      "required": [
        "risk",
        "classification",
        "allowed_callers"
      ],
      "title": "CardPolicy",
      "type": "object"
    },
    "DataClassification": {
      "description": "Sensitivity label. Ordered from least to most restricted.",
      "enum": [
        0,
        1,
        2,
        3
      ],
      "title": "DataClassification",
      "type": "integer"
    },
    "Lifecycle": {
      "enum": [
        "draft",
        "approved",
        "deprecated",
        "revoked"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "RiskLevel": {
      "description": "Action risk tier. Ordered so policies can compare with ``>=``.",
      "enum": [
        1,
        2,
        3,
        4
      ],
      "title": "RiskLevel",
      "type": "integer"
    }
  },
  "$id": "https://github.com/kogunlowo123/mcp-a2a-gateway/schemas/agent-card-version.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved By"
    },
    "card": {
      "$ref": "#/$defs/AgentCard"
    },
    "card_digest": {
      "title": "Card Digest",
      "type": "string"
    },
    "card_id": {
      "title": "Card Id",
      "type": "string"
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/CardPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "registered_at": {
      "format": "date-time",
      "title": "Registered At",
      "type": "string"
    },
    "registered_by": {
      "title": "Registered By",
      "type": "string"
    },
    "signature_alg": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature Alg"
    },
    "signature_kid": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature Kid"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "status": {
      "$ref": "#/$defs/Lifecycle",
      "default": "draft"
    },
    "status_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Reason"
    },
    "sunset_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sunset At"
    },
    "trust_domain": {
      "title": "Trust Domain",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "card_id",
    "version",
    "trust_domain",
    "card",
    "card_digest",
    "registered_by",
    "registered_at",
    "updated_at"
  ],
  "title": "AgentCardVersion",
  "type": "object"
}
